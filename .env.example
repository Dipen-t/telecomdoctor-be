# Database
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/telemedicine?schema=public"

# Redis
REDIS_URL="redis://localhost:6380"

# JWT (REQUIRED — server will refuse to start without these)
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="replace-with-a-different-strong-random-secret"

# Server
PORT=3000
LOG_LEVEL="info"
NODE_ENV="development"

# CORS (in production, set to your frontend domain)
CORS_ORIGIN="*"

# LiveKit Video (mock keys for development)
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
LIVEKIT_WS_URL="wss://mock-telemedicine-abcd.livekit.cloud"
